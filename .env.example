# Runtime
SERVICE_NAME=reservation-api
APP_ENV=local
IS_DEV_MODE=true
PORT=8080

# Database
DATABASE_URL=sqlite:///./.local/reservation_api.db
# Cloud SQL example:
# DATABASE_URL=postgresql+psycopg://reservation_user:DB_PASSWORD@/reservation?host=/cloudsql/reservation-io:asia-northeast3:reservation-db

# Security
SECRET_KEY=change-this-to-a-long-random-string
OTP_SECRET_KEY=change-this-to-another-long-random-string

# Admin login
ADMIN_ID=admin
ADMIN_PASSWORD=change-this-password
ADMIN_LOGIN_FAIL_LIMIT=5
DB_BASED_IP_BAN=false
ANTI_MACRO_DURATION=10
ANTI_MACRO_RETENTION_SECONDS=3600

# Kakao OAuth
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_TOKEN_URL=https://kauth.kakao.com/oauth/token
KAKAO_USERINFO_URL=https://kapi.kakao.com/v2/user/me

# OTP
OTP_TIMEOUT_SECOND=30
OTP_DELTA=1
OTP_QR_HASH_ALGORITHM=md5
OTP_MANUAL_HASH_ALGORITHM=sha1
OTP_MANUAL_CODE_LENGTH=12
OTP_MANUAL_CODE_REGISTRY_BACKEND=memory
OTP_MANUAL_CODE_COLLECTION=manual_otp_codes
OTP_MANUAL_CODE_MAX_ATTEMPTS=16
FIRESTORE_PROJECT_ID=reservation-io
FIRESTORE_DATABASE=(default)

# Frontend / CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Time display
APP_TIMEZONE=Asia/Seoul
DISPLAY_TIMEZONE_LABEL=Seoul, KR

# Event bus readiness
MESSAGE_BUS_BACKEND=none
VISIT_EVENT_TOPIC=
